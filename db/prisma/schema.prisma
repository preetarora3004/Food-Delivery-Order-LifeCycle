generator client {
    provider = "prisma-client"
    output   = "../generated/prisma"
}

datasource db {
    provider = "postgresql"
}

enum Status {
    ORDERED
    CANCELLED
    ORDER_ACCEPTED
    ORDER_REJECTED
    ORDER_PREPARING
    ORDER_PREPARED
    ORDER_HANDLED
    PICKUP_ACCEPTED
    PICKUP_REJECTED
    ORDER_DELIVERING
    ORDER_DELIVERED
}

model User {
    id       String @id @default(cuid())
    username String
    password String

    createdAt DateTime @default(now())
    order     Order[]

    @@unique(username)
    @@index([username])
}

model Restaurant {
    id   String @id @default(cuid())
    name String

    items  Item[]
    orders Order[]

    @@index([name])
}

model DeliveryAgent {
    id   String @id @default(cuid())
    name String

    deliveryOrder DeliveryOrder[]

    createdAt DateTime @default(now())

    @@index([name])
}

model Item {
    id   String @id @default(cuid())
    name String

    restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
    restaurantId String

    orders Order[]

    createdAt DateTime @default(now())

    @@index([name, restaurantId])
}

model Order {
    id String @id @default(cuid())

    status Status

    restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
    restaurantId String

    user   User   @relation(fields: [userId], references: [id])
    userId String

    item   Item   @relation(fields: [itemId], references: [id])
    itemId String

    deliveryOrders DeliveryOrder[]

    createdAt DateTime @default(now())

    @@index(userId)
    @@index(restaurantId)
}

model DeliveryOrder {
    id String @id @default(cuid())

    order   Order  @relation(fields: [orderId], references: [id])
    orderId String

    deliveryAgent   DeliveryAgent @relation(fields: [deliveryAgentId], references: [id])
    deliveryAgentId String

    createdAt DateTime @default(now())

    @@index(orderId)
    @@index(deliveryAgentId)
}
